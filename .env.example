# Discord Configuration
# IMPORTANT: Never commit real tokens to git.
DISCORD_TOKEN=your_discord_bot_token_here
ATTENDANCE_CHANNEL_ID=your_channel_id_here

# Google Login Credentials
# Use an App Password if 2FA is enabled.
GOOGLE_EMAIL=your_google_email@kalvium.community
GOOGLE_PASSWORD=your_google_app_password_or_password

# Optional (these have defaults)
# KALVIUM_URL=https://kalvium.community
# CHECK_INTERVAL=10
# TIMEZONE=Asia/Kolkata

# Gemini Vision (optional but required for DETECTION_MODE=vision)
# Get an API key from https://aistudio.google.com/ and set it here
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# DETECTION_MODE=vision  # or 'scraper' to use HTML/text selectors
